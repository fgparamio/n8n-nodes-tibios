			"parameters": {
				"httpMethod": "POST",
				"path": "tibios-run",
				"responseMode": "onReceived",
				"options": {}
			}
		},
		{
			"id": "w2",
			"name": "Get the whole run",
			"type": "n8n-nodes-tibios.tibios",
